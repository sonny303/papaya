{
  "name": "papaya-health-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.18.x",
    "pnpm": "11.19.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf:dev": "pnpm build && wrangler dev",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:repo": "node scripts/check-public-repository.mjs",
    "check:source": "node scripts/check-source-integrity.mjs",
    "check:public": "node scripts/check-public-build.mjs",
    "verify": "pnpm check:repo && pnpm check:source && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:public"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.5",
    "jsdom": "30.0.1",
    "oxlint": "1.82.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  }
}
